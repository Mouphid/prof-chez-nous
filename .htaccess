# ============================================================
# Joie Enseignante — configuration Apache
# ============================================================

# Bloquer l'accès aux dossiers sensibles
RedirectMatch 403 ^/(config|includes|sql|vendor|logs)/.*$

# Protéger les fichiers sensibles à la racine
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|skills-lock\.json|README\.md)$">
    Require all denied
</FilesMatch>

# Désactiver le listing des répertoires
Options -Indexes

# ─── Forcer HTTPS ───
# À conserver : une fois le certificat SSL actif sur OVH, tout le trafic
# passe automatiquement en https://.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ─── Headers de sécurité ───
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Politique de sécurité du contenu (CSP) — mode observation.
    # Elle n'empêche rien pour l'instant : elle signale dans la console du
    # navigateur les ressources non prévues. Après avoir testé le paiement
    # Kkiapay et vérifié qu'aucune alerte rouge n'apparaît, remplacer
    # « Content-Security-Policy-Report-Only » par « Content-Security-Policy »
    # pour activer le blocage.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.kkiapay.me; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.kkiapay.me https://api-sandbox.kkiapay.me https://cdn.kkiapay.me; frame-src 'self' https://cdn.kkiapay.me https://*.kkiapay.me; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# ─── Compression ───
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Cache des fichiers statiques ───
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Bloquer l'exécution PHP dans uploads
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ public/sitemap.php [L]
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|phps)$ - [F,L]

    # Documents et vidéos : jamais d'accès direct.
    # Ils passent par public/download.php, public/video.php et public/course_file.php,
    # qui contrôlent les droits.
    RewriteRule ^uploads/(pdf|docs|audio|video|cours)/ - [F,L]
</IfModule>

# Empêcher l'accès au dossier _debug_backup
RedirectMatch 403 ^/_debug_backup/.*$

# Page 404 personnalisée
ErrorDocument 404 /public/404.php
