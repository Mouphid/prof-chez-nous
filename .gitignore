# Documentation et notes internes (gardées uniquement en local, hors Git)
*.md

# Logs
logs/
*.log

# Uploads
# Le contenu envoyé par l'admin n'est pas versionné, mais les fichiers de
# protection (.htaccess) et les marqueurs de dossier (.gitkeep) le sont.
uploads/*
!uploads/index.html
!uploads/*/
uploads/*/*
!uploads/*/.gitkeep
!uploads/*/.htaccess
!uploads/word/.gitkeep
!uploads/hero/.gitkeep
# Cours : sous-dossiers de fichiers protégés (deux niveaux)
!uploads/cours/pdf/
!uploads/cours/video/
uploads/cours/pdf/*
uploads/cours/video/*
!uploads/cours/pdf/.gitkeep
!uploads/cours/video/.gitkeep
!uploads/cours/pdf/.htaccess
!uploads/cours/video/.htaccess

