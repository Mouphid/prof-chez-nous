# Ces fichiers ne doivent jamais être servis directement.
# Ils passent uniquement par public/course_file.php, qui contrôle
# l'achat (cours complet ou chapitre) avant d'envoyer le fichier.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
